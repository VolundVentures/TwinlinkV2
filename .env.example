# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxx
SUPABASE_SECRET_KEY=xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM — OpenAI Responses API (agent loop + script writer + titles)
OPENAI_API_KEY=xxx
# AGENT_MODEL=gpt-6-sol
# SCRIPT_MODEL=gpt-6-sol
# LLM_REASONING_EFFORT=low

# Runway API — ALL generation goes through Runway:
#   images  → gpt_image_2_5_sunburst / gpt_image_2_5_flare
#   scenes  → seedance2_5 (25s, native audio)
#   edits   → aleph2 (coverage / signature / notes)
#   audio   → eleven_v3 (VO), eleven_text_to_sound_v2 (ambient), seed_audio (score)
#   finish  → magnific_video_upscaler_creative (4K master)
RUNWAYML_API_SECRET=xxx
# RUNWAY_MAX_INFLIGHT=5

# Reference image search (web scraping, not generation)
FIRECRAWL_API_KEY=xxx

# Remotion video composition (Lambda rendering)
REMOTION_AWS_ACCESS_KEY_ID=xxx
REMOTION_AWS_SECRET_ACCESS_KEY=xxx
REMOTION_FUNCTION_NAME=remotion-render-2048mb-240sec
REMOTION_SERVE_URL=https://remotionlambda-xxx.s3.us-east-1.amazonaws.com/sites/twinlink-remotion/index.html
REMOTION_REGION=us-east-1
